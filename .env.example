# ==============================================================================
# TaskLane Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit real passwords, secret tokens, or sensitive credentials to Git.

# ------------------------------------------------------------------------------
# 1. Docker Compose Configuration (Default Stack)
# ------------------------------------------------------------------------------
# Default credentials below are intended for LOCAL DEVELOPMENT ONLY.
# In production, replace with strong, randomly generated secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasklane

# Connection URL used by the FastAPI app container inside the Docker Compose network
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tasklane

# ------------------------------------------------------------------------------
# 2. Standalone / Bare-Metal Alternatives (Outside Docker)
# ------------------------------------------------------------------------------
# For local development without Docker using SQLite:
# DATABASE_URL=sqlite:///./tasklane.db
#
# For local development connecting to PostgreSQL running directly on the host:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasklane

# ------------------------------------------------------------------------------
# 3. Application Server Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (used at Vite build time)
# ------------------------------------------------------------------------------
# In local Vite dev server: http://localhost:8000
# In containerized / production builds (same-origin): leave empty
VITE_API_BASE_URL=
