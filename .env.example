# ==============================================================================
# TaskLane Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit real passwords, secret tokens, or sensitive credentials to Git.

# Database Connection URL
# Examples:
#   Local SQLite (default):
#     DATABASE_URL=sqlite:///./tasklane.db
#   Local PostgreSQL:
#     DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasklane
#   Docker Compose stack (internal service name 'postgres'):
#     DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tasklane
DATABASE_URL=sqlite:///./tasklane.db

# Application Server Host and Port
HOST=0.0.0.0
PORT=8000

# Frontend API Base URL (used at build time by Vite)
# In local development: http://localhost:8000
# In production container (same-origin): leave empty
VITE_API_BASE_URL=
