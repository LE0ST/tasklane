# Dedicated isolated test worker container for TaskLane on-call remediation verification.
# Runs candidate patched code with NO network egress, unprivileged non-root user,
# read-only root filesystem, and strict resource bounding.
FROM python:3.11-slim

# Create dedicated unprivileged non-root user (uid 10001, gid 10001)
RUN groupadd -g 10001 worker && useradd -u 10001 -g worker -m -d /home/worker -s /bin/sh worker

WORKDIR /workspace

# Install minimal test verification dependencies
RUN pip install --no-cache-dir \
    pytest==9.1.1 \
    fastapi==0.162.0 \
    sqlalchemy==2.1.6 \
    pydantic==2.14.1 \
    httpx==0.28.1 \
    starlette==1.10.0 \
    anyio==4.15.1 \
    pyyaml==6.0.2 \
    alembic==1.13.3 \
    opentelemetry-sdk>=1.44.0

# Switch to unprivileged non-root user
USER 10001:10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace

ENTRYPOINT ["pytest"]
CMD ["-v"]
